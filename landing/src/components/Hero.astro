---
import PanelMockup from "./PanelMockup.astro";
import Icon from "./Icon.astro";
import { DOWNLOAD, REPO } from "./links";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="top"
  style="background: var(--color-parchment); padding-top: clamp(72px, 12vh, 132px); padding-bottom: clamp(64px, 10vh, 120px); overflow: hidden;"
>
  <div
    class="hero-grid"
    style="max-width: 1080px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: center;"
  >
    <div class="reveal">
      <span
        class="t-caption"
        style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 9999px; background: #fff; border: 1px solid var(--color-hairline); color: var(--color-ink-80); margin-bottom: 22px;"
      >
        <span style="width: 7px; height: 7px; border-radius: 9999px; background: #34c759;"></span>
        {t.hero.badge}
      </span>

      <h1 class="t-hero" style="max-width: 14ch;">{t.hero.title}</h1>

      <p class="t-lead" style="color: var(--color-ink-80); margin-top: 22px; max-width: 30ch;">
        {t.hero.leadBefore}<kbd
          style="font-family: var(--font-mono); font-size: 0.82em; padding: 2px 8px; border-radius: 8px; background: #fff; border: 1px solid var(--color-hairline);"
        >⌘`</kbd>{t.hero.leadAfter}
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px;">
        <a href={DOWNLOAD} class="btn btn-primary">
          <Icon name="download" /> {t.hero.download}
        </a>
        <a href={REPO} target="_blank" rel="noreferrer" class="btn btn-ghost">
          <Icon name="github" /> {t.hero.github}
        </a>
      </div>

      <p class="t-fine" style="color: var(--color-ink-48); margin-top: 18px;">
        {t.hero.fine}
      </p>
    </div>

    <div class="reveal" style="display: flex; justify-content: center; animation-delay: 120ms;">
      <PanelMockup />
    </div>
  </div>
</section>
