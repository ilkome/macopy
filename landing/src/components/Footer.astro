---
import Logo from "./Logo.astro";
import LangSwitcher from "./LangSwitcher.astro";
import { LICENSE, RELEASES, REPO, SITE, VERSION } from "./links";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// hrefs are presentation; labels come from t.footer.links in the same order.
const HREFS = [REPO, RELEASES, LICENSE, SITE];
---

<footer style="background: var(--color-parchment); padding: 64px 0 40px;">
  <div style="max-width: 1080px; margin: 0 auto; padding: 0 24px;">
    <div
      class="footer-row"
      style="display: flex; align-items: flex-start; justify-content: space-between; gap: 32px; flex-wrap: wrap;"
    >
      <div style="max-width: 32ch;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
          <span style="border-radius: 9px; overflow: hidden; display: block; width: 34px; height: 34px;">
            <Logo size={34} />
          </span>
          <span class="t-tagline">MaCopy</span>
        </div>
        <p class="t-caption" style="color: var(--color-ink-48);">
          {t.footer.tagline}
        </p>
      </div>

      <nav style="display: flex; gap: 48px; flex-wrap: wrap;">
        <div style="display: flex; flex-direction: column;">
          <span class="t-caption" style="font-weight: 600; margin-bottom: 8px;">{t.footer.projectHeading}</span>
          {
            t.footer.links.map((label, i) => (
              <a
                href={HREFS[i]}
                target="_blank"
                rel="noreferrer"
                class="t-body footer-link"
                style="color: var(--color-ink-80); text-decoration: none; line-height: 2.1;"
              >
                {label}
              </a>
            ))
          }
        </div>
      </nav>
    </div>

    <div
      style="margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--color-hairline); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;"
    >
      <span class="t-fine" style="color: var(--color-ink-48);">© 2026 ilkome · v{VERSION}</span>
      <div style="display: flex; align-items: center; gap: 16px;">
        <LangSwitcher lang={lang} />
        <span class="t-fine" style="color: var(--color-ink-48);">{t.footer.madeOn}</span>
      </div>
    </div>
  </div>
</footer>
