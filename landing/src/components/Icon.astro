---
// Quiet line glyphs - 1.6px stroke, currentColor, no fills. UI recedes.
interface Props {
  name:
    | "tags"
    | "scan"
    | "search"
    | "link"
    | "shield"
    | "focus"
    | "key"
    | "bolt"
    | "return"
    | "github"
    | "download"
    | "layers"
    | "folder"
    | "message"
    | "lock"
    | "eye"
    | "code"
    | "palette"
    | "clock"
    | "check";
  size?: number;
  class?: string;
}

const { name, size, class: cls } = Astro.props;

const linePaths: Record<string, string> = {
  tags: '<path d="M3 7.5A1.5 1.5 0 0 1 4.5 6H11l8.5 8.5a1.5 1.5 0 0 1 0 2.1l-3.9 3.9a1.5 1.5 0 0 1-2.1 0L4 12V7.5Z" /><circle cx="7.5" cy="10" r="1.2" />',
  scan: '<path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" /><path d="M4 12h16" />',
  search: '<circle cx="11" cy="11" r="6.5" /><path d="m20 20-3.6-3.6" />',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.5 1.5" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.5-1.5" />',
  shield: '<path d="M12 3 5 6v5.5c0 4.4 3 7.3 7 9 4-1.7 7-4.6 7-9V6l-7-3Z" /><path d="m9.2 11.8 1.9 1.9 3.7-3.9" />',
  focus: '<circle cx="12" cy="12" r="3" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3" />',
  key: '<path d="M3 12h12M6 9l-3 3 3 3" />',
  bolt: '<path d="M13 3 5 13h6l-1 8 8-10h-6l1-8Z" />',
  return: '<path d="M21 6v4a3 3 0 0 1-3 3H4" /><path d="m8 9-4 4 4 4" />',
  layers: '<path d="m12 3 9 4.9-9 4.9L3 7.9 12 3Z" /><path d="m3 13 9 4.9L21 13" /><path d="m3 16.5 9 4.9 9-4.9" />',
  folder: '<path d="M3 7.5C3 6.7 3.7 6 4.5 6h4l2 2h9c.8 0 1.5.7 1.5 1.5v8c0 .8-.7 1.5-1.5 1.5h-15C3.7 19 3 18.3 3 17.5v-10Z" />',
  message: '<path d="M5 5h14c.6 0 1 .4 1 1v9c0 .6-.4 1-1 1h-7l-4 3.5V16H5c-.6 0-1-.4-1-1V6c0-.6.4-1 1-1Z" />',
  lock: '<rect x="5" y="10.5" width="14" height="9.5" rx="2" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" />',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="3" />',
  code: '<path d="m8.5 8-4 4 4 4" /><path d="m15.5 8 4 4-4 4" /><path d="m13.5 5.5-3 13" />',
  palette: '<path d="M12 3.5c3.5 4 6 7 6 9.8a6 6 0 0 1-12 0c0-2.8 2.5-5.8 6-9.8Z" />',
  clock: '<circle cx="12" cy="12" r="9" /><path d="M12 7.5v5l3.2 1.9" />',
  check: '<path d="m5 12.5 4.2 4.2L19 7" />',
};

const s = size ?? (name === "github" || name === "download" ? 18 : 28);
---

{
  name === "github" ? (
    <svg
      width={s}
      height={s}
      viewBox="0 0 24 24"
      fill="currentColor"
      class={cls}
      aria-hidden="true"
    >
      <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
    </svg>
  ) : name === "download" ? (
    <svg
      width={s}
      height={s}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={cls}
      aria-hidden="true"
    >
      <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16" />
    </svg>
  ) : (
    <svg
      width={s}
      height={s}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={cls}
      aria-hidden="true"
      set:html={linePaths[name]}
    />
  )
}
