    "Filters out JWTs, API keys (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) and high-entropy strings. Such entries never reach the history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtert JWTs, API-Schlüssel (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) und Zeichenketten mit hoher Entropie heraus. Solche Einträge gelangen nicht in den Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters out JWTs, API keys (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) and high-entropy strings. Such entries never reach the history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra los JWT, las claves de API (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) y las cadenas de alta entropía. Esas entradas nunca llegan al historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre les JWT, les clés API (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) et les chaînes à forte entropie. Ces entrées n'apparaissent jamais dans l'historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra i JWT, le chiavi API (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) e le stringhe ad alta entropia. Queste voci non finiscono nella cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JWT、API キー（AWS、GitHub、Stripe、OpenAI、Anthropic、Google）、高エントロピー文字列を除外します。これらは履歴に残りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JWT, API 키(AWS, GitHub, Stripe, OpenAI, Anthropic, Google) 및 고엔트로피 문자열을 걸러냅니다. 이러한 항목은 기록에 남지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odfiltrowuje tokeny JWT, klucze API (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) i ciągi o wysokiej entropii. Takie wpisy nie trafiają do historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra JWTs, chaves de API (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) e strings de alta entropia. Esses itens nunca chegam ao histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отфильтровывает JWT, API-ключи (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) и строки с высокой энтропией. Такие записи не попадают в историю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JWT'leri, API anahtarlarını (AWS, GitHub, Stripe, OpenAI, Anthropic, Google) ve yüksek entropili dizeleri filtreler. Bu tür kayıtlar geçmişe girmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过滤 JWT、API 密钥（AWS、GitHub、Stripe、OpenAI、Anthropic、Google）以及高熵字符串。这些内容不会进入历史记录。"
          }
        }
      }
    },
